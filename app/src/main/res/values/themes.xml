<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.AppTaxiHGO" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/marca</item>
        <item name="colorOnPrimary">@color/tinta</item>
        <item name="colorSecondary">@color/tinta</item>
        <item name="colorOnSecondary">@color/blanco</item>
        <item name="android:colorBackground">@color/relleno</item>
        <item name="colorSurface">@color/blanco</item>
        <item name="colorOnSurface">@color/tinta</item>
        <item name="colorError">@color/peligro</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialButtonStyle">@style/Widget.TaxiHGO.Boton</item>
    </style>

    <style name="Theme.AppTaxiHGO" parent="Base.Theme.AppTaxiHGO" />

    <!-- Texto -->
    <style name="Texto" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/tinta</item>
    </style>
    <style name="Texto.Titulo2">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Texto.Subtitulo">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Texto.Precio">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Texto.Secundario">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/tinta_2</item>
    </style>
    <style name="Texto.SecundarioMedio">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/tinta_2</item>
    </style>
    <style name="Texto.Pie">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/tinta_2</item>
    </style>

    <!-- Botones -->
    <style name="Widget.TaxiHGO.Boton" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/fondo_boton_principal</item>
        <item name="android:textColor">@color/tinta</item>
        <item name="cornerRadius">14dp</item>
    </style>
    <style name="Widget.TaxiHGO.Boton.Secundario">
        <item name="backgroundTint">@color/relleno_2</item>
        <item name="android:textColor">@color/tinta</item>
    </style>
    <style name="Widget.TaxiHGO.Boton.Secundario.Compacto">
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">14sp</item>
        <item name="iconTint">@color/tinta</item>
    </style>
    <style name="Widget.TaxiHGO.Boton.TextoPeligro" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/peligro</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.TaxiHGO.BotonCircular" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/tinta</item>
        <item name="backgroundTint">@color/relleno_2</item>
        <item name="cornerRadius">24dp</item>
    </style>
    <style name="Widget.TaxiHGO.BotonCircular.Flotante">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="backgroundTint">@color/blanco</item>
        <item name="cornerRadius">26dp</item>
        <item name="android:elevation">4dp</item>
    </style>

    <!-- Progreso y navegación -->
    <style name="Widget.TaxiHGO.Progreso" parent="Widget.Material3.LinearProgressIndicator">
        <item name="indicatorColor">@color/marca</item>
        <item name="trackColor">@color/relleno_2</item>
        <item name="trackThickness">4dp</item>
        <item name="trackCornerRadius">2dp</item>
    </style>
    <style name="Widget.TaxiHGO.Navegacion" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/blanco</item>
        <item name="itemIconTint">@color/tinta</item>
        <item name="itemTextColor">@color/tinta</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.TaxiHGO.Navegacion.Indicador</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
    <style name="Widget.TaxiHGO.Navegacion.Indicador" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/marca</item>
    </style>
</resources>
