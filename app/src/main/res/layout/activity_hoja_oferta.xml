<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/margen"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/margen"
    android:paddingBottom="24dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/tirador" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Texto.Pie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nueva_solicitud"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:textColor="@color/tinta" />

            <TextView
                android:id="@+id/tv_tarifa"
                style="@style/Texto.Precio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="34sp" />

            <TextView
                style="@style/Texto.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/efectivo_estimado" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/pb_tiempo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:max="20"
                app:indicatorColor="@color/tinta"
                app:indicatorSize="60dp"
                app:trackColor="@color/relleno_2"
                app:trackThickness="5dp" />

            <TextView
                android:id="@+id/tv_segundos"
                style="@style/Texto.Subtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_distancia"
        style="@style/Texto.SecundarioMedio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:textColor="@color/tinta"
        app:drawableStartCompat="@drawable/ic_navegar"
        app:drawableTint="@color/tinta" />

    <LinearLayout
        android:id="@+id/grupo_ruta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_tarjeta_gris"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal">

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/punto_origen" />

            <TextView
                android:id="@+id/tv_origen"
                style="@style/Texto.SecundarioMedio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/tinta" />
        </LinearLayout>

        <View
            android:layout_width="2dp"
            android:layout_height="12dp"
            android:layout_marginStart="11dp"
            android:background="@drawable/linea_ruta" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal"
                android:layout_weight="1">

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/cuadro_destino" />

                <TextView
                    android:id="@+id/tv_destino"
                    style="@style/Texto.SecundarioMedio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/tinta" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_referencia"
        style="@style/Texto.Pie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        app:drawableStartCompat="@drawable/ic_nota"
        app:drawableTint="@color/tinta_2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_persona"
            app:tint="@color/tinta" />

        <TextView
            android:id="@+id/tv_pasajero"
            style="@style/Texto.SecundarioMedio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:textColor="@color/tinta" />

        <TextView
            android:id="@+id/tv_calificacion_pasajero"
            style="@style/Texto.Pie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="4dp"
            app:drawableStartCompat="@drawable/ic_estrella"
            app:drawableTint="@color/tinta" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_rechazar"
            style="@style/Widget.TaxiHGO.Boton.Secundario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/rechazar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_aceptar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="2"
            android:text="@string/aceptar" />
    </LinearLayout>
</LinearLayout>
