<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/relleno"
    android:keepScreenOn="true">

    <!-- MAPA PRINCIPAL -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapa"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/mapa" />

    <!-- CAPA SUPERIOR -->
    <LinearLayout
        android:id="@+id/capa_superior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- ESTADO DE CONEXIÓN -->
        <LinearLayout
            android:id="@+id/pildora_estado"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_pildora_blanca"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp">

            <View
                android:id="@+id/punto_estado"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_circulo_gris" />

            <TextView
                android:id="@+id/tv_estado"
                style="@style/Texto.SecundarioMedio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/desconectado"
                android:textColor="@color/tinta" />

        </LinearLayout>

    </LinearLayout>

    <!-- CONTENEDOR INFERIOR -->
    <LinearLayout
        android:id="@+id/contenedor_inferior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <!-- BOTÓN MI UBICACIÓN -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mi_ubicacion"
            style="@style/Widget.TaxiHGO.BotonCircular.Flotante"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/mi_ubicacion"
            app:icon="@drawable/ic_mi_ubicacion" />

        <!-- HOJA INFERIOR -->
        <LinearLayout
            android:id="@+id/hoja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hoja"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingStart="@dimen/margen"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/margen"
            android:paddingBottom="16dp">

            <!-- INDICADOR -->
            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/tirador" />

            <!-- TÍTULO -->
            <TextView
                android:id="@+id/tv_titulo"
                style="@style/Texto.Titulo2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/estas_desconectado" />

            <!-- MENSAJE -->
            <TextView
                android:id="@+id/tv_mensaje"
                style="@style/Texto.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/activa_disponibilidad" />

            <!-- BARRA DE PROGRESO -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/pb_esperando"
                style="@style/Widget.TaxiHGO.Progreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <!-- TARJETAS DE ESTADÍSTICAS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- VIAJES HOY -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tarjeta_gris"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tv_viajes_hoy"
                        style="@style/Texto.Subtitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="—" />

                    <TextView
                        style="@style/Texto.Pie"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/viajes_hoy" />

                </LinearLayout>

                <!-- COBRADO HOY -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_tarjeta_gris"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tv_total_hoy"
                        style="@style/Texto.Subtitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="—" />

                    <TextView
                        style="@style/Texto.Pie"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/cobrado_hoy" />

                </LinearLayout>

                <!-- CALIFICACIÓN -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_tarjeta_gris"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tv_calificacion"
                        style="@style/Texto.Subtitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="—" />

                    <TextView
                        style="@style/Texto.Pie"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/tu_calificacion" />

                </LinearLayout>

            </LinearLayout>

            <!-- BANNER -->
            <include
                layout="@layout/include_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <!-- CARGANDO -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/pb_cargando"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/tinta"
                app:indicatorSize="32dp" />

            <!-- BOTÓN DISPONIBILIDAD -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_disponibilidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/conectarme" />

        </LinearLayout>

        <!-- NAVEGACIÓN INFERIOR -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/navegacion"
            style="@style/Widget.TaxiHGO.Navegacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menu="@menu/menu_navegacion" />

    </LinearLayout>

</FrameLayout>
